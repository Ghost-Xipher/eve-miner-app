{
  "name": "eve-miner",
  "version": "1.1.0",
  "description": "EVE Online mining helper: ore values, yield calculator and mining planner (desktop app and browser page)",
  "main": "main.js",
  "author": "EVE Miner",
  "scripts": {
    "start": "electron .",
    "web": "node tools/serve.js",
    "dist": "electron-builder --win",
    "test": "node tests/core-test.js && node tests/page-test.js",
    "check-data": "node tools/check-data.js"
  },
  "build": {
    "appId": "com.example.eveminer",
    "productName": "EVE Miner",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "lib/**",
      "assets/map.js",
      "assets/mining.js",
      "assets/icon-*.png"
    ],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon-512.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "EVE-Miner-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "EVE-Miner-${version}-portable.${ext}" },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^24.0.0"
  },
  "engines": { "node": ">=22.13" }
}
